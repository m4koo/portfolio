---
const { title, description, tech, githubUrl, imageUrl } = Astro.props;
---

<div class="border border-slate-700 rounded-xl overflow-hidden bg-slate-900/50 hover:shadow-xl hover:shadow-blue-900/20 hover:-translate-y-1 transition-all duration-300">
  
  <!-- Bildbereich: Mit flex und object-contain werden Logos und Screenshots optimal eingepasst -->
  <div class="h-48 bg-slate-800/50 flex items-center justify-center border-b border-slate-700 p-6">
    <img 
      src={imageUrl} 
      alt={`Vorschau von ${title}`} 
      class="max-w-full max-h-full object-contain" 
    />
  </div>
  
  <div class="p-6">
    <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
    
    <p class="text-slate-300 mb-4">
      {description}
    </p>
    
    <div class="mb-6">
      <span class="inline-block bg-blue-900/30 text-blue-300 text-sm px-3 py-1 rounded-full font-medium border border-blue-800/50">
        {tech}
      </span>
    </div>
    
    <a href={githubUrl} target="_blank" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors">
      Projekt ansehen &rarr;
    </a>
  </div>
</div>