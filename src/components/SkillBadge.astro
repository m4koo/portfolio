---
const { name, level } = Astro.props;
---

<div class="flex items-center justify-between p-3 bg-slate-900/50 border border-slate-700 rounded-lg">
  <span class="font-medium text-slate-200">{name}</span>
  <span class="text-xs bg-blue-900/30 text-blue-300 border border-blue-800/50 px-2.5 py-1 rounded-full font-semibold">
    {level}
  </span>
</div>