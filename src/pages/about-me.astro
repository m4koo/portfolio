---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
---

<BaseLayout>

    <div class="max-w-3xl">
        <h1 class="text-3xl font-bold text-white mb-6">Über mich</h1>
    
        <div class="text-slate-300 leading-relaxed">
            <p class="text-lg mb-6">
                Hallo! Ich bin ein lernbegeisterter Junior Webentwickler mit einer großen Leidenschaft für moderne Frontend-Technologien, sauberen Code und nutzerzentriertes Design.
            </p>
            
            <h2 class="text-xl font-semibold text-white mt-8 mb-4">Meine Motivation</h2>
            <p class="mb-6 text-slate-300">
                Als Quereinsteiger habe ich mir fundierte Grundlagen erarbeitet und bilde mich kontinuierlich weiter. Mein Fokus liegt darauf, mein theoretisches Wissen in der Praxis anzuwenden, robuste Webanwendungen zu bauen und dabei stets nach Best Practices zu arbeiten. Die ständige Weiterentwicklung in der Tech-Welt treibt mich an.
            </p>

            <!-- Das Grid für deine Skill-Badges -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                <SkillBadge name="HTML5 / CSS3" level="Fortgeschritten" />
                <SkillBadge name="JavaScript (ES6+)" level="Grundlagen" />
                <SkillBadge name="Astro Framework" level="Fortgeschritten" />
                <SkillBadge name="Tailwind CSS" level="Fortgeschritten" />
                <SkillBadge name="Git & GitHub" level="Fortgeschritten" />
                <SkillBadge name="Responsive Design" level="Fortgeschritten" />
            </div>
            
            <h2 class="text-xl font-semibold text-white mt-8 mb-4">Meine Schwerpunkte</h2>
            <ul class="list-disc list-inside space-y-2 mb-8">
                <li>Moderne Frontend-Entwicklung (HTML, CSS, JavaScript)</li>
                <li>Komponentenbasierte Architektur mit Frameworks wie Astro</li>
                <li>Effizientes und responsives Styling mit Tailwind CSS</li>
                <li>Versionskontrolle und saubere Projektstruktur mit Git/GitHub</li>
            </ul>
        </div>
    </div>
</BaseLayout>