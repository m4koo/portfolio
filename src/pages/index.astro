---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Hier importieren wir dein neues Bild direkt über Astro
import myPhoto from '../pics/photo/itsame.jpeg';
---

<BaseLayout>
  <!-- Hero-Sektion: Der erste Eindruck -->
  <section class="py-12 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      
      <!-- Linke Spalte: Text -->
      <div class="max-w-2xl">
        <span class="text-blue-400 font-semibold text-sm uppercase tracking-wider mb-3 block">
          Junior Webentwickler & Quereinsteiger
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6 leading-tight">
          Hallo, ich bin Mahmut. Ich baue moderne Webanwendungen mit Fokus auf Clean Code.
        </h1>
        <p class="text-lg text-slate-300 mb-8 leading-relaxed">
          Hier zeige ich meine Projekte, meinen Tech-Stack und meinen Weg in die professionelle Webentwicklung. Lass uns gemeinsam digitale Erlebnisse gestalten.
        </p>
        
        <div class="flex flex-wrap gap-4">
          <a href="/projects" class="px-6 py-3 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 transition-colors shadow-sm hover:shadow">
            Projekte ansehen &rarr;
          </a>
          <!-- Button an den dunklen Hintergrund angepasst -->
          <a href="/contact" class="px-6 py-3 bg-slate-800 border border-slate-700 text-slate-200 font-medium rounded-xl hover:bg-slate-700 transition-colors">
            Kontakt aufnehmen
          </a>
        </div>
      </div>

      <!-- Rechte Spalte: Polaroid Foto -->
      <div class="flex justify-center md:justify-end">
        <!-- Der Polaroid-Rahmen mit leichter Drehung und Hover-Effekt -->
        <div class="bg-white p-3 pb-12 shadow-2xl rounded-sm transform rotate-3 hover:rotate-0 transition-transform duration-300 max-w-xs w-full">
          <img 
            src={myPhoto.src} 
            alt="Foto von Mahmut" 
            class="w-full h-auto object-cover rounded-sm border border-slate-200" 
          />
        </div>
      </div>
      
    </div>
  </section>

  <!-- Kleine Vorschau-Sektion für Top-Projekte -->
  <section class="border-t border-slate-800 pt-12 pb-16">
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-2xl font-bold text-white">Ausgewählte Projekte</h2>
      <a href="/projects" class="text-blue-400 hover:text-blue-300 font-semibold text-sm transition-colors">
        Alle anzeigen &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <ProjectCard 
        title="Task-Manager (Beispiel)"
        description="Eine interaktive Kanban-Board-Anwendung zur Verwaltung von täglichen Aufgaben."
        tech="React, Tailwind"
        githubUrl="https://github.com"
        imageUrl="https://via.placeholder.com/600x400/0f172a/334155?text=Task+Manager+Screenshot"
      />
      <ProjectCard 
        title="Wetter-App (Beispiel)"
        description="Ein Dashboard, das Wetterdaten einer externen API abruft und grafisch darstellt."
        tech="JavaScript, API"
        githubUrl="https://github.com"
        imageUrl="https://via.placeholder.com/600x400/0f172a/334155?text=Wetter+App+Screenshot"
      />
    </div>
  </section>
</BaseLayout>